{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/p/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|intro.gif|logo.webp|bundle.js|styles.css|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
